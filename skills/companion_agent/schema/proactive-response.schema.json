{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:companion-agent-skill:proactive-response",
  "title": "Companion proactive response",
  "oneOf": [
    {
      "type": "object",
      "required": ["action"],
      "properties": {
        "action": {"const": "skip"},
        "reason_code": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["action", "stages"],
      "properties": {
        "action": {"const": "send"},
        "stages": {
          "type": "array",
          "minItems": 1,
          "maxItems": 11,
          "items": {
            "type": "object",
            "required": ["bubbles"],
            "properties": {
              "bubbles": {
                "type": "array",
                "minItems": 1,
                "maxItems": 5,
                "items": {"type": "string", "minLength": 1, "maxLength": 120}
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  ]
}
